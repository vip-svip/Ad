[Script]

GearPro=type=http-response,pattern=^https?:\/\/api\.revenuecat\.com\/v1\/(subscribers|receipts|customers\/subscribers|product_entitlement_mapping)\/.*,requires-body=1,script-path=https://cdn.jsdelivr.net/gh/vip-svip/Ad@main/JS/GearCrack.js

[MITM]

hostname = %APPEND% api.revenuecat.com